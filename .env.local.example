# Supabase — get these from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Together AI — used server-side only (Edge Functions), never exposed to the client.
# Not read directly by Next.js; set as a Supabase Edge Function secret in Phase 6.
# TOGETHER_API_KEY=your-together-api-key
