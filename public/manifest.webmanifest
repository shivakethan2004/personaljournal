{
  "name": "Process Journal",
  "short_name": "Process Journal",
  "description": "A journaling app that adapts to your patterns and domains.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f0e6",
